# Leave unset to use the same-origin /api/session endpoint.
# For a separately hosted API, set the full API base URL, including /api/session.
# VITE_API_BASE_URL=https://api.example.com/api/session

# Optional: Vite development proxy target (defaults to http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
